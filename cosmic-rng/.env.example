# ============================================================================
# COSMIC RNG — environment configuration
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env && chmod 600 .env
# ============================================================================

# --- core -------------------------------------------------------------------
ENVIRONMENT=production
# 32+ random chars. Generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://cosmic:CHANGE_ME@127.0.0.1:5432/cosmic_rng
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# --- public URLs ------------------------------------------------------------
# The origin players use. Cookies and CSRF checks are bound to it.
PUBLIC_BASE_URL=https://rng.example.com
# Extra allowed origins (comma separated). PUBLIC_BASE_URL is always allowed.
ALLOWED_ORIGINS=

# --- Discord OAuth (required) ----------------------------------------------
# https://discord.com/developers/applications → OAuth2
#   Redirect URI must be exactly:  https://rng.example.com/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://rng.example.com/api/auth/callback

# --- Discord DM notifications (optional) -----------------------------------
# Bot token from the same application (Bot → Reset Token). The bot must share a
# server with each DM recipient. Recipients are configured in the admin panel.
DISCORD_BOT_TOKEN=

# --- administrators ---------------------------------------------------------
# Comma separated Discord user IDs. These are super admins and cannot be
# demoted from the panel. Other admins are promoted with:
#   python -m app.cli set-role <discord_id> admin
ADMIN_DISCORD_IDS=

# --- cookies / proxy --------------------------------------------------------
COOKIE_SECURE=true
# Set only when serving several subdomains, e.g. .example.com
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
# Addresses whose X-Forwarded-For is trusted (your Nginx).
TRUSTED_PROXIES=127.0.0.1,::1

# --- runtime ----------------------------------------------------------------
# postgres = LISTEN/NOTIFY across workers (required when WORKERS > 1)
EVENT_BUS=postgres
RUN_SCHEDULER=true
LOG_LEVEL=INFO
LOG_FILE=/var/log/cosmic-rng/app.log

# --- backups ----------------------------------------------------------------
BACKUP_DIR=/var/backups/cosmic-rng
BACKUP_KEEP=30
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# --- development only -------------------------------------------------------
# Refused in production; lets you log in without Discord while developing.
DEV_LOGIN_ENABLED=false
