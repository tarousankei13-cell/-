# Discord Bot Token (required)
BOT_TOKEN=your_bot_token_here

# Bot prefix for legacy commands (default: !)
BOT_PREFIX=!

# Guild ID for slash command sync (speeds up dev; leave blank for global sync)
GUILD_ID=

# Role names
ADMIN_ROLE=Admin
STAFF_ROLE=Staff

# ── Channel IDs ────────────────────────────────────────────────────────────
# Order notifications
ORDER_LOG_CHANNEL=

# Ticket creation category
TICKET_CATEGORY=

# General announcements
ANNOUNCE_CHANNEL=

# Flash sale announcements
FLASH_SALE_CHANNEL=

# Achievement unlock announcements
ACHIEVEMENT_CHANNEL=

# Rank-up announcements
RANK_UP_CHANNEL=

# ── Economy ────────────────────────────────────────────────────────────────
DAILY_REWARD=500
STARTING_BALANCE=1000
REFERRAL_REWARD=1000
CURRENCY_NAME=ポイント
CURRENCY_EMOJI=💰

# ── Shop limits ────────────────────────────────────────────────────────────
MAX_CART_ITEMS=20
MAX_CART_QUANTITY=99
