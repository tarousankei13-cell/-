# Discord Bot Token (required)
BOT_TOKEN=your_bot_token_here

# Bot prefix for legacy commands (default: !)
BOT_PREFIX=!

# Guild ID for slash command sync (optional, speeds up sync in development)
GUILD_ID=

# Admin role name or ID (users with this role get admin commands)
ADMIN_ROLE=Admin

# Staff role name or ID (users with this role can see/manage tickets)
STAFF_ROLE=Staff

# Channel IDs (optional - set to enable specific features)
# Channel where order notifications are sent
ORDER_LOG_CHANNEL=

# Channel where tickets are created
TICKET_CATEGORY=

# Channel where shop announcements are posted
ANNOUNCE_CHANNEL=

# Economy settings
DAILY_REWARD=500
STARTING_BALANCE=1000
CURRENCY_NAME=ポイント
CURRENCY_EMOJI=💰

# Shop settings
MAX_CART_ITEMS=20
MAX_CART_QUANTITY=99
